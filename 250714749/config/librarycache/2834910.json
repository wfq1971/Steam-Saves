[["achievementmap",{"version":5,"data":"[]"}],["usernews",{"version":5,"data":["COoHEMf0mcsGGRzRrgIAAHABISRMr2YBABABKd5BKwAAAAAAUXAFMM9zeBIHYMf0mcsGcMf0mcsG","COoHELz/9MoGGRzRrgIAAHABISRMr2YBABABKd5BKwAAAAAAUZQEQOa4dhIHYLz/9MoGcLz/9MoG","COoHEKWghsoGGRzRrgIAAHABISRMr2YBABABKd5BKwAAAAAAUXoCYBw5dkYJYKWghsoGcKWghsoG","COoHELCr4ckGGRzRrgIAAHABISRMr2YBABABKd5BKwAAAAAAUSMGMKuRdRIHYLCr4ckGcLCr4ckG","COoHEKPBl8kGGRzRrgIAAHABISRMr2YBABABKd5BKwAAAAAAUdoE0OlrdJoIYKPBl8kGcKPBl8kG","COoHEKnM8sgGGRzRrgIAAHABISRMr2YBABABKd5BKwAAAAAAURwEIPsQdLoIYKnM8sgGcKnM8sgG"]}],["gameactivity",{"version":5,"data":[]}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"Ubisoft San Francisco","strURL":"https://store.steampowered.com/developer/ubisoft"},{"strName":"Ubisoft Osaka","strURL":"https://store.steampowered.com/developer/ubisoft"},{"strName":"Ubisoft Bucharest","strURL":null},{"strName":"Ubisoft Pune","strURL":"https://store.steampowered.com/developer/ubisoft"}],"rgPublishers":[{"strName":"Ubisoft","strURL":"https://store.steampowered.com/publisher/ubisoft"}],"rgFranchises":[{"strName":"Rocksmith","strURL":null}]}}],["descriptions",{"version":1,"data":{"strFullDescription":"透過包含數千首歌曲，且還會不斷擴充的曲目庫學習吉他與鋼琴！\r\n\r\n《Rocksmith 搖滾史密斯+》是獲獎肯定的音樂學習服務，其前代遊戲《Rocksmith 搖滾史密斯 2014》因音樂授權事宜而需停止後續的更新及支援服務。\r\n\r\n《Rocksmith 搖滾史密斯+》的授權歌曲清單會有所變化且持續擴展，不僅保留前代遊戲幫助數百萬名玩家學會吉他的主要特色內容，還包含鋼琴教學——而且不必另外付費。\r\n\r\n遊戲主要功能「Riff 循環播放器」與「自適應難度」等皆可用來幫助你磨練技巧。《Rocksmith 搖滾史密斯》是唯一能隨著遊玩過程調整難度的音樂學習服務。現在就加入超過 500 萬名玩家的行列，藉由即時回饋及歌曲練習，按照自己的步調來學習吧。搖滾不息！\r\n\r\n註：若已購買《Rocksmith 搖滾史密斯 2014》，還是可繼續使用。","strSnippet":"透過包含數千首歌曲，且還會不斷擴充的曲目庫學習吉他與鋼琴！"}}],["achievements",{"version":2,"data":{"vecHighlight":[],"vecUnachieved":[{"strID":"RS+_ACH_15","strName":"突破","strDescription":"在任一編曲中達到 25% 以上的精通。","strImage":"https://shared.steamstatic.com/community_assets/images/apps/2834910/61be32511feab56d558b447472d1a26eb9d05dc4.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":26.399999618530273,"flMinProgress":0,"flCurrentProgress":0,