flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"10","strName":"Back-2-Back","strDescription":"Get 25 double kills","strImage":"https://shared.steamstatic.com/community_assets/images/apps/677620/398317407c61ee6b99011c74a37ce9982bdf8768.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":45.20000076293945,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"13","strName":"Headhunter","strDescription":"Get 50 headshot kills","strImage":"https://shared.steamstatic.com/community_assets/images/apps/677620/250169ae1c59fb5f939d3390353b157d44ec18d0.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":42.20000076293945,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"14","strName":"Where Are You Going?","strDescription":"Destroy 10 enemy portals","strImage":"https://shared.steamstatic.com/community_assets/images/apps/677620/b6fb7e750ef67e63e05190c16a87d54a3dcca475.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":38.599998474121094,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"2","strName":"Competitor ","strDescription":"Complete 25 matches","strImage":"https://shared.steamstatic.com/community_assets/images/apps/677620/a4b4c6d1ef4258122857da961a807c3352bc7d50.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":35.099998474121094,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"12","strName":"Unstoppable","strDescription":"Get a quad kill","strImage":"https://shared.steamstatic.com/community_assets/images/apps/677620/bb0ac50b85d6e4cc45f0d3617505722a41fda191.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":29.700000762939453,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"8","strName":"Fragtastic","strDescription":"Get 15 kills without dying","strImage":"https://shared.steamstatic.com/community_assets/images/apps/677620/5ec0637b76d1fbb0a1c953acdafd4ffabb673168.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":27.700000762939453,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"24","strName":"Deadly","strDescription":"Deal 50,000 damage to enemies ","strImage":"https://shared.steamstatic.com/community_assets/images/apps/677620/bf28d43247c3f1f0fe79d43f542ae07d4e9b8098.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":27.399999618530273,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0}],"vecAchievedHidden":[],"nTotal":30,"nAchieved":0}}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"1047 Games","strURL":null}],"rgPublishers":[{"strName":"1047 Games","strURL":null}],"rgFranchises":[]}}],["descriptions",{"version":1,"data":{"strFullDescription":"Splitgate 是一款免費遊玩、節奏步調快速的多人射擊遊戲，以玩家控制傳送門為此遊戲特色。這款科幻射擊遊戲將第一人稱射擊遊戲升至新次元，結合其傳送門機制，實現了高空飛行及多維戰鬥。Splitgate 喚起了玩家對過去二十年最受崇敬的神作射擊遊戲的回憶，它不僅包羅了經典和近距離戰鬥的熟悉手感，同時還新增了獨特的變化。IGN 將 Splitgate 描述為「Halo 碰上 Portal」。\r\n\r\n[h2]傳送門戰鬥：一種新型射擊遊戲[/h2]\r\n保持四處警戒，並利用傳送門戰鬥在空中飛行、側翼和擊殺時體驗激烈的穿梭動作，來不斷智勝智取對手。沒有什麼比在傳送迴圈圍繞一位仍然認為你站在他面前的困惑敵人，接著從後面直接無瞄準爆頭更讚的了！\r\n\r\n[h2]全方位、功能齊全的免費多人遊戲體驗[/h2]\r\nSplitgate 提供多達 20 幾張遊戲地圖，每種都有其獨特的設定及玩法，此外還有可磨練的挑戰、數十種自定義角色、爭鋒排行榜及排名系統，以及超過 15 種休閒競技遊戲模式。這些遊戲地圖包括在活火山內的研究設施、水下豪華飯店及外星人墜毀地點等等。每張地圖都有其專屬外觀和氣氛，玩法也不盡相同，在只有 Splitgate 具備的快步調、傳送門戰鬥中調整他們作戰方式的玩家即可獲得獎勵。更別說遊戲還是免費的。\r\n\r\n[h2]在跨多人平台上與你的朋友相見歡[/h2]\r\n跨平台遊戲功能讓你能夠跨遊戲機和電腦與朋友對戰。標準第一人稱射擊遊戲操控及直觀的傳送門機制，讓初學者也能立即上手，並伴有競爭或休閒模式，讓你可以與任何技術水準的朋友同樂。你還可以建立一個附修改器的自定義大廳，玩你所想。我們強烈建議低重力無限彈藥大頭模式！","strSnippet":"Spligate 是一款節奏快速的免費多人射擊遊戲，以玩家控制的傳送門為特色。這款科幻射擊遊戲讓玩家利用傳送門機制進行高空多維戰鬥，將第一人稱射擊遊戲提升到全新的領域。IGN 評價 Splitgate 為「Halo 結合 Portal」的遊戲。"}}]]