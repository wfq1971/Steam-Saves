\":93.9000015258789,\"strID\":\"first_slice\"}],[\"meet_bishop\",{\"strName\":\"Sweetheart Bishop\",\"strDescription\":\"Met Bishop. His motto - Pray, preach, and look like you won the lottery.\",\"strImage\":\"https://shared.steamstatic.com/community_assets/images/apps/599140/6af917b3f9155cba585a0456add5447a6f4bb444.jpg\",\"flAchieved\":92.9000015258789,\"strID\":\"meet_bishop\"}],[\"meet_snake\",{\"strName\":\"Shady Snake\",\"strDescription\":\"Met Snake. He seems dangerous. You get why everybody calls him Snake. \",\"strImage\":\"https://shared.steamstatic.com/community_assets/images/apps/599140/66b8bef014921bbfe046714378b33b3f6e6cf635.jpg\",\"flAchieved\":82.4000015258789,\"strID\":\"meet_snake\"}]]]]"}],["usernews",{"version":5,"data":["CB4Q6vXszgYZT++cSwEAEAEhAAAAAAAAAAApZCQJAAAAAAA=","CAkQhOvozgYZSaUMGAEAEAEhAAAAAAAAAAApZCQJAAAAAAA=","COoHENKt384GGYEvqgEAAHABIdhvKm0BABABKWQkCQAAAAAAUcADgF/yf9YGYKeK5M4GcNKt384G","CAIQ9PjszgYZT++cSwEAEAEhAAAAAAAAAAApZCQJAAAAAABCC2J1cnlfMV9ib2R5QgtmaXJzdF9zbGljZUILbWVldF9iaXNob3A=","CAIQ/aXtzgYZT++cSwEAEAEhAAAAAAAAAAApZCQJAAAAAABCCm1lZXRfc25ha2U="]}],["gameactivity",{"version":5,"data":[]}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"Lazy Bear Games","strURL":"https://store.steampowered.com/curator/32946824"}],"rgPublishers":[{"strName":"tinyBuild","strURL":"https://store.steampowered.com/publisher/tinybuild"}],"rgFranchises":[{"strName":"tinyBuild","strURL":"https://store.steampowered.com/franchise/tinybuild"}]}}],["descriptions",{"version":1,"data":{"strFullDescription":"Graveyard Keeper is the most inaccurate medieval cemetery management sim of all time. Build and manage your own graveyard, and expand into other ventures, while finding shortcuts to cut costs. Use all the resources you can find. After all, this is a game about the spirit of capitalism, and doing whatever it takes to build a thriving business. And it’s also a love story.\r\n\r\n[imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/599140/extras/5268ad7d068b83df25436875c7c4bdb6.poster.avif?t=1775826330\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/599140/extras/5268ad7d068b83df25436875c7c4bdb6.webm?t=1775826330\" width=\"634\" height=\"556\"][/imgvid]\r\n\r\n[list][*]Face ethical dilemmas. Do you [i]really[/i] want to spend money on that proper burger meat for the witch-burning festival, when you have so many resources lying around? \r\n[*]Gather valuable materials and craft new items. Expand your Graveyard into a thriving business. Help yourself -- gather the valuable resources scattered across the surrounding areas, and explore what this land has to offer. \r\n[*]Quests and corpses. These dead bodies don't need all those organs, do they? Why not grind them up and sell them to the local butcher? Or you can go on proper quests, you roleplayer.\r\n[*]Explore mysterious dungeons. No medieval game would be complete without those! Take a trip into the unknown, and find discover new alchemy ingredients -- which may or may not poison a whole bunch of nearby villagers.[/list]","strSnippet":"Build and manage a medieval graveyard while facing ethical dilemmas and making questionable decisions. Welcome to Graveyard Keeper, the most inaccurate medieval cemetery sim of the year."}}],["achievements",{"version":2,"data":{"vecHighlight":[],"vecUnachieved":[{"strID":"first_slice","strName":"First slice","strDescription":"Got your first slice of meat. Smells a little strange, but looks like ordinary meat...","strImage":"https://shared.steamstatic.com/community_assets/images/apps/599140/1be3af219306bc768d863ec55d1001b16905bd19.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":95.4000015258789,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"bury_1_body","strName":"Novice gravedigger","strDescription":"Buried your first body.","strImage":"https://shared.steamstatic.com/community_assets/images/apps/599140/e2d3abb94996332f1bc2d92f2a37cf75d67926bb.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":94.9000015258789,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"meet_bishop","strName":"Sweetheart Bishop","strDescription":"Met Bishop. His motto - Pray, preach, and look like you won the lottery.","strImage":"https://shared.steamstatic.com/community_assets/images/apps/599140/fc36393766de5af91cfb713e2d82492308c64a84.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":94.80000305175781,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"meet_snake","strName":"Shady Snake","strDescription":"Met Snake. He seems dangerous. You get why everybody calls him Snake. ","strImage":"https://shared.steamstatic.com/community_assets/images/apps/599140/6a1ea75b757af63c3befabd1a2ab1bdee5b9644d.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":86.69999694824219,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"meet_inq","strName":"Holy Inquisition","strDescription":"Met the Lord Inquisitor. An unwavering kind of guy. You definitely wouldn't want to be his enemy.","strImage":"https://shared.steamstatic.com/community_assets/images/apps/599140/b2c29d915b2af059d3bc589b1da926a5132e39c9.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":75.30000305175781,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"meet_actress","strName":"Charm itself","strDescription":"Met Ms Charm. There's something about this woman that you can't understand.","strImage":"https://shared.steamstatic.com/community_assets/images/apps/599140/3cc55ca3bbd229904d412ee4be296c0db88c7192.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":74.5,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"fix_garden","strName":"Even here","strDescription":"Fixed the garden. You'll spend a lot of time here...","strImage":"https://shared.steamstatic.com/community_assets/images/apps/599140/5605239474dec3e09875d462f1ae96f25aeb0e9f.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":71,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"meet_merch","strName":"Wealthy merchant","strDescription":"Met Merchant. He's always ready to do business. Except around dinner time.","strImage":"https://shared.steamstatic.com/community_assets/images/apps/599140/6bfe62d19e5472b8cba158ea6c0dfd53e525e8e3.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":68.9000015258789,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"meet_astro","strName":"Old Astrologer","strDescription":"Met Astrologer. He's wise and tired of everything, even life.","strImage":"https://shared.steamstatic.com/community_assets/images/apps/599140/6660c8a821b287e05c9a062a3e2645c02b2009d4.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":61.900001525878906,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"fix_bridge","strName":"Bridge builder","strDescription":"Fixed the bridge. Whatever else happens, you'll always be remembered as a great bridge builder!","strImage":"https://shared.steamstatic.com/community_assets/images/apps/599140/b2dc726cf7ab733d3e0f4f59bebae7f50d3ab261.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":58.79999923706055,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"astro_skull","strName":"A perfect gift","strDescription":"Gave a skull to Astrologer. A skull makes a nice present indeed!","strImage":"https://shared.steamstatic.com/community_assets/images/apps/599140/a02c945eb587f20f698946c4efe3a7ff060ae5a9.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":56.099998474121094,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"bury_10_bodies","strName":"Advanced gravedigger","strDescription":"Buried 10 bodies.","strImage":"https://shared.steamstatic.com/community_assets/images/apps/599140/7744436200b06a17713eb37d09b008dc28996057.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":49.79999923706055,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0}],"vecAchievedHidden":[],"nTotal":12