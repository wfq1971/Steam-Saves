n":5,"data":"[]"}],["usernews",{"version":5,"data":[]}],["gameactivity",{"version":5,"data":[]}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"Turquoise Revival Games","strURL":"https://store.steampowered.com/developer/TurquoiseRevivalGames"}],"rgPublishers":[{"strName":"GrabTheGames","strURL":"https://store.steampowered.com/publisher/GrabTheGames"},{"strName":"WhisperGames","strURL":"https://store.steampowered.com/publisher/WhisperGames"}],"rgFranchises":[{"strName":"Turquoise Revival Games","strURL":"https://store.steampowered.com/franchise/TurquoiseRevivalGames"},{"strName":"GrabTheGames Publishing","strURL":"https://store.steampowered.com/franchise/GrabTheGames"}]}}],["descriptions",{"version":1,"data":{"strFullDescription":"[h2][b][u]Repair toys[/u][/b][/h2]\r\n[imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1510580/extras/24cd14b64c2a7405e0550e3ae7e6001b.poster.avif?t=1766952026\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1510580/extras/24cd14b64c2a7405e0550e3ae7e6001b.webm?t=1766952026\" width=\"620\" height=\"140\"][/imgvid]\r\n[list]\r\n[*]Disassemble/assemble toy parts and go through  the repair processes like cleaning, painting, sandblasting, coating, sanding, sewing, filling/stuffing etc[/list]\r\n[list]\r\n[*]Repair as many toys as possible to earn more money and experience[/list]\r\n[list]\r\n[*]Take before/after photos to see the progress[/list]\r\n\r\n[h2][b][u]Design your office and workshop[/u][/b][/h2]\r\n[imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1510580/extras/d45acbae8c978ccec26d13f9d0090624.poster.avif?t=1766952026\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1510580/extras/d45acbae8c978ccec26d13f9d0090624.webm?t=1766952026\" width=\"620\" height=\"140\"][/imgvid]\r\n[list]\r\n[*]Buy furniture, carpets, paintings, plants, flowers, etc and design your office[/list]\r\n[list]\r\n[*]Buy new tools and equipment to increase your portfolio[/list]\r\n\r\n[h2][b][u]Start your toy-museums[/u][/b][/h2]\r\n[imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1510580/extras/b925b3c5a8f8292bd2b97538a7b00725.poster.avif?t=1766952026\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1510580/extras/b925b3c5a8f8292bd2b97538a7b00725.webm?t=1766952026\" width=\"620\" height=\"140\"][/imgvid]\r\n[list]\r\n[*]Buy and repair unique toys[/list]\r\n[list]\r\n[*]Buy new buildings and design your toy-museums[/list]\r\n\r\n[h2][b][u]Play with master-toys[/u][/b][/h2]\r\n[imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1510580/extras/2aa995826c2dc4d0a0a40a144170d445.poster.avif?t=1766952026\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1510580/extras/2aa995826c2dc4d0a0a40a144170d445.webm?t=1766952026\" width=\"620\" height=\"140\"][/imgvid]\r\n[list]\r\n[*]Level up and become master[/list]\r\n[list]\r\n[*]Play with master-toys after successful deliveries[/list]","strSnippet":"Have you ever wanted to be a toy tinker? This is a unique chance to become one! Repair toys and start your toy-museums to make everyone happy!"}}],["badge",{"version":1,"data":{"dtNextRetry":null,"strName":"","strIconURL":"https://cdn.fastly.steamstatic.com/steamcommunity/public/images/items/1510580/","nLevel":0,"nMaxLevel":5,"nXP":0,"bMaxed":null,"strNextLevelName":"Recruit","nNextLevelXP":100,"rgCards":[{"strName":"Paint","strTitle":"Paint","strImgURL":"https://community.fastly.steamstatic.com/economy/image/IzMF03bk9WpSBq-S-ekoE33L-iLqGFHVaU25ZzQNQcXdA3g5gMEPvUZZEfSMJ6dESN8p_2SVTY7V2NgKxXMJkD4QPivs0XEwVeRlNt-AyQj6pufQSCGhazGXdnDdGFxpTrFcYTnQrzqhs7mTQGmaE70qQg8CefBR8zFJO9fTf0UrhthJr2CqqE1wHxEtL5weJFrokyZFM-wkmiJBcc1RyC31dMCLhF0xbkY5D7nmUO2RaIb0wSc6HUQwCeYXZlAYKsa6","strArtworkURL":"https://cdn.fastly.steamstatic.com/steamcommunity/public/images/items/1510580/9a4b2