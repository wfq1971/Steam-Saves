[["achievementmap",{"version":5,"data":"[]"}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"Treyarch","strURL":null},{"strName":"Raven Software","strURL":null},{"strName":"Beenox","strURL":null},{"strName":"High Moon Studios","strURL":null},{"strName":"Sledgehammer Games","strURL":null},{"strName":"Infinity Ward","strURL":null},{"strName":"Activision Shanghai","strURL":null},{"strName":"Demonware","strURL":null}],"rgPublishers":[{"strName":"Activision","strURL":"https://store.steampowered.com/publisher/Activision"}],"rgFranchises":[{"strName":"Call of Duty","strURL":"https://store.steampowered.com/franchise/callofduty"},{"strName":"Modern Warfare","strURL":"https://store.steampowered.com/franchise/callofduty"},{"strName":"Modern Warfare II","strURL":"https://store.steampowered.com/franchise/callofduty"},{"strName":"Modern Warfare III","strURL":"https://store.steampowered.com/franchise/callofduty"},{"strName":"Black Ops","strURL":"https://store.steampowered.com/franchise/callofduty"}]}}],["descriptions",{"version":1,"data":{"strFullDescription":"[p]《決勝時刻®》體驗支援《決勝時刻®：黑色行動 7》、《決勝時刻®：黑色行動 6》和《決勝時刻®：現代戰域™》。[/p][p]Treyarch和Raven Software聯手打造的最新力作《決勝時刻®：黑色行動 7》將帶領玩家深入史上規模最大的《黑色行動》。[/p][p]《決勝時刻®：黑色行動 6》是經典《黑色行動 》的系列新作，內容包含電影般的單人劇情戰役、同類別中最佳的多人遊戲和史詩回歸的回合制殭屍模式。[/p][p]《決勝時刻®：現代戰域™》是免費遊玩的大型戰鬥，主打大逃殺和捲土重來體驗。[/p][p];《決勝時刻®》點數（CP）*是遊戲內貨幣，可用來購買《黑色行動 7》、《黑色行動 6》、《現代戰爭® III 2023》，《現代戰爭® II 2022》 與《決勝時刻®：現代戰域™》的全新內容。[/p][p]需要擁有《決勝時刻®：黑色行動 7》、需要擁有《決勝時刻®：黑色行動 6》、《決勝時刻®：現代戰爭® III 2023》、《決勝時刻®：現代戰爭® II 2022》 或《決勝時刻®：現代戰域™》才可兌換。獨立販售 / 下載。[/p][p]你所購買的《決勝時刻®》點數也可在特定具有《決勝時刻®》點數功能的《決勝時刻®》系列遊戲使用，並用以換取其中的遊戲內容。各款遊戲均為獨立販售。[/p]","strSnippet":"《決勝時刻®》體驗支援《決勝時刻®：黑色行動 7》、《決勝時刻®：黑色行動 6》和《決勝時刻®：現代戰域™》。"}}],["usernews",{"version":5,"data":["COoHEOXkgskGGUmGiAIAAHABIbHP7lkBABABKaqSHQAAAAAAUeMFEPRrdIYIYJeT7MkGcOXkgskG","COoHEJq0x8kGGUmGiAIAAHABIbHP7lkBABABKaqSHQAAAAAAUdIEQKuRdQIHYJq0x8kGcJq0x8kG","COoHEKCNwskGGUmGiAIAAHABIbHP7lkBABABKaqSHQAAAAAAUWQBQKuRdQIHYKCNwskGcKCNwskG","COoHELiMwskGGU